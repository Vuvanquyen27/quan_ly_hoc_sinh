# ==========================================================================
# EduFlow — Biến môi trường (mẫu)
# --------------------------------------------------------------------------
# Sao chép tệp này thành `.env.local` và điền giá trị thật. KHÔNG commit
# `.env.local`. KHÔNG bao giờ đặt SERVICE_ROLE với tiền tố NEXT_PUBLIC_.
# Lấy giá trị Supabase tại: Project Settings → API.
# ==========================================================================

# --- Công khai (được nhúng vào bundle trình duyệt — CHỈ đặt giá trị không bí mật) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"          # Khóa anon — RLS bảo vệ, an toàn để lộ
NEXT_PUBLIC_SITE_URL="http://localhost:3000"           # URL công khai (đổi khi deploy)

# Bản địa hóa (mặc định Việt Nam)
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
NEXT_PUBLIC_DEFAULT_LOCALE="vi"
NEXT_PUBLIC_DEFAULT_CURRENCY="VND"

# --- BÍ MẬT (CHỈ dùng ở máy chủ — KHÔNG có tiền tố NEXT_PUBLIC_, KHÔNG ra client) ---
# Dùng duy nhất trong lib/supabase/admin.ts cho thao tác ADMIN (bỏ qua RLS).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-KEEP-SECRET"

# --- Tùy chọn / phiên bản sau ---
# TRIAL_DAYS="14"                                       # Số ngày dùng thử mặc định
# RESEND_API_KEY=""                                     # Gửi email (khi thêm thông báo email)
# CRON_SECRET=""                                        # Bảo vệ endpoint cron (nhắc hạn, hóa đơn định kỳ)
